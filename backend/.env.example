# Copy to .env and edit. .env is not committed.

# mock | cmsai | ollama
LLM_PROVIDER=mock

# Instructor AI service (campus network / VPN required)
CMSAI_URL=http://cmsai:8000/generate/
CMSAI_MAX_TOKENS=1024
CMSAI_TIMEOUT=120

# Local Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT=300

MAX_FILES=10
MAX_TOTAL_CHARS=60000
PORT=8000
